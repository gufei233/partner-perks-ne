{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["@types/node"],
    // tsx 直接运行 .ts 源码，无需编译产出
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["main.ts", "src/**/*.ts", "tests/**/*.ts", "deploy/**/*.ts"],
  "exclude": ["node_modules", ".tmp", ".session-state", ".acl-recovery"]
}
